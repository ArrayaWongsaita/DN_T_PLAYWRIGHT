{
  "name": "dn-t-playwright-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port ${PORT:-3000}",
    "build": "next build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "report": "playwright show-report",
    "test:solutions": "PW_SOLUTIONS=1 playwright test",
    "setup:browsers": "playwright install chromium",
    "start": "next start --port ${PORT:-3000}",
    "serve:e2e": "[ -f .next/BUILD_ID ] || next build; next start --port ${PORT:-3000}",
    "solutions:apply": "node scripts/apply-solutions.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
